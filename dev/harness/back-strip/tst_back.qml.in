import QtQuick
import QtTest
import "file://@REPO@" as Notch

// The press on the way-back strip, under a parent that handles taps the way the
// notch's island does (Bar.qml: a TapHandler with a long-press threshold, whose
// singleTapped runs the notch's own click gesture -- which opens the widgets when
// nothing is open). A press on the strip must go back and must not also be that
// click: with the panel closed by the back step, the click opens the widgets
// again, and the press seems to do nothing.
TestCase {
  id: tc
  name: "BackStrip"
  width: 300
  height: 200
  visible: true
  when: windowShown

  property int islandTaps: 0
  property int steps: 0
  property int underClicks: 0
  property bool underOn: false
  property bool offered: true

  Item {
    id: island
    anchors.fill: parent
    TapHandler {
      acceptedButtons: Qt.LeftButton
      longPressThreshold: 0.45
      onSingleTapped: tc.islandTaps++
      onDoubleTapped: tc.islandTaps++
    }
    // A control of the panel under the strip's zone: a press in the zone must never reach it.
    MouseArea {
      id: under
      enabled: tc.underOn
      x: 100; y: 0; width: 100; height: 32
      onClicked: tc.underClicks++
    }
    Notch.BackStrip {
      id: strip
      x: 100; y: 0; width: 100; height: 32
      offered: tc.offered
      onActivated: tc.steps++
    }
  }

  function init() { steps = 0; islandTaps = 0; underClicks = 0; underOn = false; offered = true }

  function test_01_a_press_on_the_strip_goes_back_once() {
    mouseClick(island, 150, 10)
    wait(700)
    compare(steps, 1)
  }
  function test_02_and_is_not_also_the_islands_click() {
    mouseClick(island, 150, 10)
    wait(700)
    compare(islandTaps, 0)
  }
  function test_03_beside_the_strip_is_the_islands_click() {
    mouseClick(island, 40, 10)
    wait(700)
    compare(steps, 0)
    compare(islandTaps, 1)
  }
  function test_04_not_offered_the_press_falls_through() {
    offered = false
    mouseClick(island, 150, 10)
    wait(700)
    compare(steps, 0)
    compare(islandTaps, 1)
  }

  // The whole zone is the target; there is no chevron or anything else drawn in it.
  function test_05_every_corner_of_the_zone_goes_back() {
    mouseClick(island, 101, 1)
    wait(700)
    mouseClick(island, 198, 1)
    wait(700)
    mouseClick(island, 101, 30)
    wait(700)
    mouseClick(island, 198, 30)
    wait(700)
    compare(steps, 4)
    compare(islandTaps, 0)
  }
  function test_06_a_press_in_the_zone_never_reaches_a_control_under_it() {
    underOn = true
    mouseClick(island, 120, 16)
    wait(700)
    compare(steps, 1)
    compare(underClicks, 0)
  }
  function test_07_one_pixel_outside_the_zone_is_not_the_strip() {
    mouseClick(island, 99, 16)
    wait(700)
    compare(steps, 0)
    mouseClick(island, 150, 33)
    wait(700)
    compare(steps, 0)
  }

  // An area with one mark: nothing is drawn at rest, a chevron fades in at the centre under the pointer,
  // and a screen reader finds a button named Back.
  function paintedThings(item, out) {
    if (item.visible && (item.text !== undefined || item.color !== undefined || item.source !== undefined) && item.opacity > 0.01) out.push(item)
    for (var i = 0; i < item.children.length; i++) paintedThings(item.children[i], out)
    return out
  }
  function test_08_at_rest_nothing_is_drawn() {
    mouseMove(island, 20, 100)
    wait(300)
    compare(paintedThings(strip, []).length, 0)
    compare(strip.hovered, false)
    compare(strip.Accessible.name, "Back")
    compare(strip.Accessible.role, Accessible.Button)
  }
  function test_09_under_the_pointer_a_chevron_fades_in_at_the_centre() {
    mouseMove(island, 105, 5)
    tryCompare(strip, "hovered", true)
    tryVerify(function () { return strip.chevronOpacity > 0.7 })
    var shown = paintedThings(strip, [])
    compare(shown.length, 1)
    compare(shown[0].objectName, "backChevron")
    compare(shown[0].text, "‹")
    // At the centre of the zone, however far the pointer is from it, and nothing else is drawn.
    var c = shown[0].mapToItem(strip, shown[0].width / 2, shown[0].height / 2)
    verify(Math.abs(c.x - strip.width / 2) < 2)
    verify(Math.abs(c.y - strip.height / 2) < 2)
  }
  function test_10_it_fades_again_when_the_pointer_leaves() {
    mouseMove(island, 150, 16)
    tryVerify(function () { return strip.chevronOpacity > 0.7 })
    mouseMove(island, 20, 100)
    tryCompare(strip, "hovered", false)
    tryVerify(function () { return strip.chevronOpacity < 0.01 })
  }
  function test_11_not_offered_there_is_no_chevron_to_show() {
    offered = false
    mouseMove(island, 150, 16)
    wait(300)
    compare(strip.visible, false)
    compare(paintedThings(strip, []).length, 0)
  }
  function test_12_reduced_motion_shows_it_without_the_fade() {
    strip.reducedMotion = true
    mouseMove(island, 20, 100)
    wait(300)
    mouseMove(island, 150, 16)
    tryCompare(strip, "hovered", true)
    // No animation to wait for: the first frame after the pointer arrives has it at full strength.
    compare(strip.chevronOpacity, 0.75)
    strip.reducedMotion = false
  }
}
