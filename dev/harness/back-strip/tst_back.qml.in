import QtQuick
import QtTest
import "file://@REPO@" as Notch

// The press on the way-back strip, under a parent that handles taps the way the
// notch's island does (Bar.qml: a TapHandler with a long-press threshold, whose
// singleTapped runs the notch's own click gesture -- which opens the widgets when
// nothing is open). A press on the strip must go back and must not also be that
// click: with the panel closed by the back step, the click opens the widgets
// again, and the press seems to do nothing.
TestCase {
  id: tc
  name: "BackStrip"
  width: 300
  height: 200
  visible: true
  when: windowShown

  property int islandTaps: 0
  property int steps: 0
  property int underClicks: 0
  property bool underOn: false
  property bool offered: true

  Item {
    id: island
    anchors.fill: parent
    TapHandler {
      acceptedButtons: Qt.LeftButton
      longPressThreshold: 0.45
      onSingleTapped: tc.islandTaps++
      onDoubleTapped: tc.islandTaps++
    }
    // A control of the panel under the strip's zone: a press in the zone must never reach it.
    MouseArea {
      id: under
      enabled: tc.underOn
      x: 100; y: 0; width: 100; height: 32
      onClicked: tc.underClicks++
    }
    Notch.BackStrip {
      id: strip
      x: 100; y: 0; width: 100; height: 32
      offered: tc.offered
      onActivated: tc.steps++
    }
  }

  function init() { steps = 0; islandTaps = 0; underClicks = 0; underOn = false; offered = true }

  function test_01_a_press_on_the_strip_goes_back_once() {
    mouseClick(island, 150, 10)
    wait(700)
    compare(steps, 1)
  }
  function test_02_and_is_not_also_the_islands_click() {
    mouseClick(island, 150, 10)
    wait(700)
    compare(islandTaps, 0)
  }
  function test_03_beside_the_strip_is_the_islands_click() {
    mouseClick(island, 40, 10)
    wait(700)
    compare(steps, 0)
    compare(islandTaps, 1)
  }
  function test_04_not_offered_the_press_falls_through() {
    offered = false
    mouseClick(island, 150, 10)
    wait(700)
    compare(steps, 0)
    compare(islandTaps, 1)
  }

  // The whole zone is the target; there is no chevron or anything else drawn in it.
  function test_05_every_corner_of_the_zone_goes_back() {
    mouseClick(island, 101, 1)
    wait(700)
    mouseClick(island, 198, 1)
    wait(700)
    mouseClick(island, 101, 30)
    wait(700)
    mouseClick(island, 198, 30)
    wait(700)
    compare(steps, 4)
    compare(islandTaps, 0)
  }
  function test_06_a_press_in_the_zone_never_reaches_a_control_under_it() {
    underOn = true
    mouseClick(island, 120, 16)
    wait(700)
    compare(steps, 1)
    compare(underClicks, 0)
  }
  function test_07_one_pixel_outside_the_zone_is_not_the_strip() {
    mouseClick(island, 99, 16)
    wait(700)
    compare(steps, 0)
    mouseClick(island, 150, 33)
    wait(700)
    compare(steps, 0)
  }

  // An area, not a button: nothing is drawn, and a screen reader still finds a button named Back.
  function paints(item) {
    if (item.visible && (item.text !== undefined || item.color !== undefined || item.source !== undefined)) return true
    for (var i = 0; i < item.children.length; i++) if (paints(item.children[i])) return true
    return false
  }
  function test_08_it_draws_nothing() {
    compare(paints(strip), false)
    compare(strip.Accessible.name, "Back")
    compare(strip.Accessible.role, Accessible.Button)
  }
}
