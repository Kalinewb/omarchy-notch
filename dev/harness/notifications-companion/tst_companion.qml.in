import QtQuick
import QtTest
import Quickshell
import "file://@REPO@/bridge"

TestCase {
  id: tc
  name: "NotificationsCompanion"
  property var comp: null
  property var stock: null
  property var api: null
  // A while ago: every row below that is not about the grace is this old.
  property real old: Date.now() / 1000 - 60

  function initTestCase() {
    Quickshell.envMap = {
      NOTCH_NOTIFICATIONS_STOCK_URL: "file://@HARNESS@/omarchy/shell/plugins/notifications/Service.qml",
      NOTCH_NOTIFICATIONS_CONNECTOR_URL: "file://@REPO@/bridge/Connector.qml"
    }
    var c = Qt.createComponent("file://@REPO@/companion/kalinewb.notch-notifications/Service.qml")
    verify(c.status === Component.Ready, c.errorString())
    comp = c.createObject(tc)
    verify(comp !== null)
    stock = comp.stockItem
    verify(stock !== null, "stock service loaded: " + comp.stockError)
  }

  // A row as Omarchy's Store.normalise() shapes it: every field, always.
  function row(key, ts, extra) {
    var r = { key: key, ts: ts, originalId: 1, transient: false, restored: false, code: "", codes: "" }
    for (var k in extra) r[k] = extra[k]
    return r
  }
  function model() { return stock.modelForTest }
  function wins() { return stock.variantsObj.instances }
  function vis() { var l = wins(); var out = []; for (var i = 0; i < l.length; i++) out.push(l[i].visible); return out.join(",") }
  function drawn(key, ts) { return key + "@" + ts }

  function test_01_found() {
    compare(comp.windowsBound, 2)
    compare(comp.suppressible, true)
    verify(comp.toastModel !== null, "the list of toasts is found by shape")
    compare(NotchNotificationsBridge.facade, comp)
    compare(comp.apiVersion, 2)
  }
  // No notch: Omarchy's own binding, untouched -- idle windows stay mapped.
  function test_02_noNotch_isOmarchysOwn() {
    compare(vis(), "true,true")
    model().append(row("a", old))
    compare(vis(), "true,true")
    model().clear()
  }
  function test_03_notchTakesOver_hides() {
    tc.api = Qt.createComponent("Api.qml").createObject(tc)
    tc.api.drawn = []
    NotchNotificationsBridge.target = tc.api
    compare(comp.takeOver, true)
    compare(vis(), "false,false", "idle: unmapped, the notch is taking them")
    tc.api.drawn = [drawn("a", old)]
    model().append(row("a", old))
    compare(comp.hideToasts, true)
    compare(vis(), "false,false")
  }
  function test_04_newArrival_staysHidden() {
    tc.api.drawn = tc.api.drawn.concat([drawn("b", old + 1)])
    model().insert(0, row("b", old + 1))
    compare(vis(), "false,false")
  }
  function test_05_undrawnRow_showsOmarchy() {
    model().append(row("c", old + 2))
    compare(vis(), "true,true")
    model().remove(model().count - 1)
    compare(vis(), "false,false")
  }
  // Six at once: the notch draws four and the last two wait for a free line,
  // so Omarchy's toast stays until the notch has drawn those too.
  function test_05b_burst_waitingRows_showOmarchy() {
    var keep = tc.api.drawn
    for (var i = 1; i <= 6; i++) model().insert(0, row("k" + i, old + 10 + i))
    compare(vis(), "true,true", "none of the burst drawn yet")
    for (i = 1; i <= 4; i++) tc.api.drawn = tc.api.drawn.concat([drawn("k" + i, old + 10 + i)])
    compare(vis(), "true,true", "rows 5-6 wait for a line")
    tc.api.drawn = tc.api.drawn.concat([drawn("k5", old + 15)])
    compare(vis(), "true,true", "row 6 still waits")
    tc.api.drawn = tc.api.drawn.concat([drawn("k6", old + 16)])
    compare(vis(), "false,false")
    // A notch that can't say which toasts it has drawn hides none.
    NotchNotificationsBridge.target = Qt.createQmlObject("import QtQuick; QtObject { property bool takeOver: true }", tc)
    compare(vis(), "true,true")
    NotchNotificationsBridge.target = tc.api
    model().remove(0, 6)
    compare(vis(), "false,false")
  }
  // A card Omarchy updates in place gets a newer ts; until the notch has drawn
  // that, the toast shows (a row old enough to be past the grace).
  function test_05c_updatedInPlace_showsUntilDrawn() {
    var at = model().count - 1
    model().setProperty(at, "ts", old + 30)
    compare(vis(), "true,true")
    tc.api.drawn = tc.api.drawn.concat([drawn("a", old + 30)])
    compare(vis(), "false,false")
  }
  // Rows the file will never hold: a card that asked not to be kept, a replay,
  // the empty-history notice, a card with a code. No grace for those.
  function test_06_neverInTheFile_showOmarchyAtOnce() {
    var now = Date.now() / 1000
    var kinds = [row("t", now, { transient: true }), row("r", now, { restored: true }),
                 row("placeholderx", now), row("o", now, { codes: "123456" }), row("p", now, { code: "123456" })]
    for (var i = 0; i < kinds.length; i++) {
      model().insert(0, kinds[i])
      compare(vis(), "true,true", kinds[i].key)
      model().remove(0)
      compare(vis(), "false,false")
    }
  }
  // A row of the kind the file keeps, a moment old: Omarchy has not written the
  // file yet, so it is let through only if the notch has still not drawn it
  // once the grace is up.
  function test_06b_justArrived_graceThenOmarchy() {
    var now = Date.now() / 1000
    model().insert(0, row("n", now))
    compare(vis(), "false,false", "within the grace")
    wait(1200)
    compare(vis(), "true,true", "grace over, still not drawn")
    tc.api.drawn = tc.api.drawn.concat([drawn("n", now)])
    compare(vis(), "false,false", "drawn: off again")
    model().remove(0)
  }
  function test_06c_justArrived_drawnInTime_neverFlashes() {
    var now = Date.now() / 1000
    var seen = []
    model().insert(0, row("q", now))
    seen.push(vis())
    wait(200)
    tc.api.drawn = tc.api.drawn.concat([drawn("q", now)])
    seen.push(vis())
    wait(1200)
    seen.push(vis())
    compare(seen.join("|"), "false,false|false,false|false,false")
    model().remove(0)
  }
  function test_07_notchDeclines_showsOmarchy() {
    tc.api.takeOver = false
    compare(vis(), "true,true")
    tc.api.takeOver = true
    compare(vis(), "false,false")
  }
  function test_08_notchGone_showsOmarchy() {
    NotchNotificationsBridge.target = null
    compare(vis(), "true,true")
    NotchNotificationsBridge.target = tc.api
    compare(vis(), "false,false")
  }
  function test_09_empty() {
    model().clear()
    compare(vis(), "false,false", "taking them: idle is off")
    tc.api.takeOver = false
    compare(vis(), "true,true", "not taking them: Omarchy's own idle")
    tc.api.takeOver = true
  }
  // Omarchy's own reason for a window to be off is kept: it steps aside for a
  // fullscreen window until a card arrives.
  function test_09b_stepAside_isKept() {
    tc.api.takeOver = false
    wins()[0].stepAside = true
    compare(vis(), "false,true")
    model().append(row("z", old + 40))
    compare(vis(), "true,true")
    model().clear()
    wins()[0].stepAside = false
    tc.api.takeOver = true
  }
  function test_10_newScreen_bound() {
    var w = Qt.createComponent("Win.qml").createObject(tc)
    var l = [wins()[0], wins()[1], w]
    stock.variantsObj.instances = l
    compare(comp.windowsBound, 3)
    compare(vis(), "false,false,false")
    model().append(row("y", old + 50))
    compare(vis(), "true,true,true")
    model().clear()
    tc.api.takeOver = false
    compare(vis(), "true,true,true")
  }
  // A click goes to Omarchy's service by the card's key.
  function test_11_serviceCalls_byKey() {
    compare(stock.rowIndexFor("nothing"), -1)
    model().append(row("x", old + 60))
    compare(stock.rowIndexFor("x"), 0)
    stock.activate("x", true)
    stock.closeToast("x", "dismissed", true)
    compare(stock.calls.join("|"), "activate x|close x dismissed")
    model().clear()
  }

  // A plugin that counts notifications looks among the service's children for
  // the one with `trackedNotifications` and listens to its `notification`. The
  // service is inside the companion's Loader, so the companion carries one.
  function test_12_serverIsFoundAmongTheChildren() {
    var found = null
    for (var i = 0; i < comp.data.length; i++)
      if (comp.data[i] && comp.data[i].trackedNotifications !== undefined) found = comp.data[i]
    verify(found !== null, "a child with trackedNotifications")
    compare(found.trackedNotifications, stock.serverForTest.trackedNotifications)
    var seen = []
    found.notification.connect(function(n) { seen.push(n.id) })
    stock.serverForTest.notification({ id: 7 })
    stock.serverForTest.notification({ id: 8 })
    compare(seen.join(","), "7,8", "every notification the server gets is passed on once")
  }
}
