import QtQuick
import QtTest
import "file://@REPO@" as Notch
import "file://@REPO@/plugins" as Plugins
import "file://@REPO@/dev/harness/panels" as Fake

// The Settings, Setup and Plugins pages on a fake bar (FakeBar.qml), under
// qmltestrunner offscreen: no window on a screen, no live shell. dev/panels.sh
// runs it; the cases are named in its output.
TestCase {
  id: tc
  name: "Panels"
  width: 420
  height: 800
  visible: true
  when: windowShown

  Fake.FakeBar { id: bar }
  Item {
    id: stage
    anchors.fill: parent
  }

  // --- helpers ------------------------------------------------------------

  // Setup's points, as the page lists them: a fix that one press does, one that restarts the bar, a handoff.
  readonly property var keys: ({ id: "menu-keys-bypass", severity: "fix", title: "Some menu keys ignore the menu switch",
                                 summary: "Move them back onto Omarchy's keys.", fix: { label: "Move keys", files: ["bindings.lua"] }, items: [] })
  readonly property var widget: ({ id: "layout-empty-widget", severity: "fix", title: "A bar item shows nothing",
                                   summary: "Restarting the bar usually fixes it.", fix: { label: "Restart bar", destroysNotch: true }, items: [] })
  readonly property var face: ({ id: "plugin-face", severity: "action", title: "Face ID needs one more step",
                                 summary: "It can't work until you finish its setup.", fix: null, items: [], handoff: { label: "Finish setup", argv: ["true"] } })
  readonly property var snap: ({ name: "snap-1", title: "Old backups moved aside", createdAt: 1700000000000, state: "verified" })

  function make(url, props) {
    var c = Qt.createComponent(url)
    if (c.status !== Component.Ready) { fail(c.errorString()); return null }
    var item = c.createObject(stage, props)
    return item
  }
  function settings() { return make("file://@REPO@/NotchSettings.qml", { bar: bar, maxHeight: 780, headerHeight: 32, width: 400 }) }
  function setupPage() {
    bar.setup.points = [keys, widget]
    bar.setup.snapshots = [snap]
    return make("file://@REPO@/NotchSetup.qml", { bar: bar, maxHeight: 780, headerHeight: 32, width: 400 })
  }
  function pluginsPage() {
    bar.pluginsViews = [{ id: "kalinewb.face", name: "Face ID", version: "2.2.0", state: "not-installed", words: "Not installed",
                          actions: [{ name: "install:kalinewb.face", label: "Install…", enabled: true, primary: true }] },
                        { id: "kalinewb.profiles", name: "Profiles", version: "1.4.0", state: "not-installed", words: "Not installed",
                          actions: [{ name: "install:kalinewb.profiles", label: "Install…", enabled: true, primary: true }] }]
    bar.pluginsCatalogue = { plugins: [{ id: "kalinewb.face", name: "Face ID", summary: "Unlocks sudo with your face instead of a password",
                                         url: "https://github.com/Kalinewb/omarchy-face.git", pin: "7632e83a205ca2b265fba5f2b7b72e848c068a6b", version: "2.2.0" },
                                       { id: "kalinewb.profiles", name: "Profiles", summary: "Saves and switches whole Omarchy setups as profiles",
                                         url: "https://github.com/Kalinewb/omarchy-profiles.git", pin: "8b4360eae8ab9cdf438e0296e799155961a03016", version: "1.4.0" }] }
    return make("file://@REPO@/plugins/NotchPlugins.qml", { bar: bar, maxHeight: 780, headerHeight: 32, width: 400 })
  }
  // Every item under `item`, depth first.
  function walk(item, out) {
    out = out || []
    out.push(item)
    var kids = item.children || []
    for (var i = 0; i < kids.length; i++) walk(kids[i], out)
    return out
  }
  function isButton(item) { return item.iconSpinning !== undefined && item.focusable !== undefined }
  // The buttons on show, bar the option lines of an open Pick (the row cursor walks those).
  function buttons(page) { return walk(page).filter(function(i) { return isButton(i) && i.visible && !i.leftAlign }) }
  function names(list) { return list.map(function(b) { return b.text }).join("|") }
  function unfocusable(page) { return names(buttons(page).filter(function(b) { return !b.focusable })) }
  // Tab through the page from its first button; the labels of the buttons reached, in order.
  function tabWalk(page, count) {
    var seen = []
    page.forceActiveFocus()
    for (var n = 0; n < count; n++) {
      keyClick(Qt.Key_Tab)
      var f = Window.activeFocusItem
      seen.push(f && f.text !== undefined ? f.text : "?")
    }
    return seen
  }
  function init() {
    bar.writes = []
    bar.configEdits = 0
    bar.setup.points = []
    bar.setup.snapshots = []
    bar.setup.job = ({})
    bar.setup.checkFailed = false
    bar.setup.calls = []
    bar.pluginCalls = []
  }
  function cleanup() { for (var i = stage.children.length - 1; i >= 0; i--) stage.children[i].destroy() }

  // --- focusable buttons (fix 2, 11) -----------------------------------------

  function test_settings_buttons_are_focusable() {
    var page = settings()
    page.press("advanced")
    page.rows().filter(function(r) { return r.rid === "keybinds" })[0].open = true
    wait(400)
    var all = buttons(page)
    verify(all.length >= 7, "buttons on show: " + all.length)
    compare(unfocusable(page), "", "buttons Tab skips")
  }
  function test_settings_tab_reaches_the_header() {
    bar.setup.enabled = true
    var page = settings()
    wait(100)
    var seen = tabWalk(page, 1)
    compare(seen.join("|"), "✕", "Tab from the top: no Setup entry at zero")
  }
  function test_the_header_entry_shows_only_above_zero() {
    var texts = function(page) { return walk(page).filter(function(i) { return isButton(i) && i.visible }).map(function(b) { return b.text }).join("|") }
    var page = settings()
    wait(50)
    compare(texts(page), "✕", "nothing at zero")
    page.destroy()
    bar.setup.issueCount = 1
    page = settings()
    wait(50)
    compare(texts(page), "1 needs attention|✕")
    page.destroy()
    bar.setup.issueCount = 2
    page = settings()
    wait(50)
    compare(texts(page), "2 need attention|✕")
    var opened = 0
    page.setupRequested.connect(function() { opened++ })
    page.press("header:setup")
    compare(opened, 1, "the entry opens the page")
    compare(JSON.stringify(page.report().badges.filter(function(b) { return b.name === "setup" })), JSON.stringify([{ name: "setup", count: 2 }]))
    bar.setup.issueCount = 0
  }
  function test_a_row_in_advanced_checks_for_problems_and_opens_the_page() {
    var page = settings()
    var row = page.rows().filter(function(r) { return r.rid === "problems" })[0]
    compare(row.label, "Check for problems")
    var opened = 0
    page.setupRequested.connect(function() { opened++ })
    page.press("advanced")
    wait(300)
    var state = walk(row).filter(function(i) { return isButton(i) })[0]
    compare(state.text, "None", "none at zero")
    state.clicked()
    compare(opened, 1)
    bar.setup.issueCount = 2
    compare(walk(row).filter(function(i) { return isButton(i) })[0].text, "2")
    bar.setup.issueCount = 0
  }
  function test_opening_settings_asks_for_a_fresh_check() {
    var page = settings()
    page.enabled = false
    page.enabled = true
    verify(bar.setup.calls.some(function(c) { return c[0] === "soon" }), "checkSoon was asked for")
  }
  function test_setup_buttons_are_focusable() {
    var page = setupPage()
    page.confirmRow = "layout-empty-widget"
    page.groups[1].open = true
    wait(400)
    verify(buttons(page).length >= 6, "buttons on show: " + buttons(page).length)
    compare(unfocusable(page), "", "buttons Tab skips")
  }
  function test_plugins_buttons_are_focusable() {
    var page = pluginsPage()
    wait(200)
    verify(buttons(page).length >= 4, "buttons on show: " + buttons(page).length)
    compare(unfocusable(page), "", "buttons Tab skips")
  }

  // --- Accessible metadata (fix 4) ---------------------------------------------

  function switches(page) { return walk(page).filter(function(i) { return i.trackHeight !== undefined && i.knobSize !== undefined }) }

  function test_every_row_has_a_name_and_a_description() {
    var page = settings()
    var bare = page.rows().filter(function(r) { return !r.Accessible.name || !r.Accessible.description || r.Accessible.name !== r.label })
    compare(bare.map(function(r) { return r.rid }).join(" "), "", "rows with no name or no tip")
    compare(page.rows().length, 29)
  }
  function test_a_switch_says_what_it_is_and_whether_it_is_on() {
    bar.notchAutoHide = true
    var page = settings()
    wait(50)
    var on = switches(page).filter(function(s) { return s.Accessible.name === "Auto-hide" })
    compare(on.length, 1)
    compare(on[0].Accessible.role, Accessible.CheckBox)
    verify(on[0].Accessible.checkable)
    verify(on[0].Accessible.checked)
    verify(on[0].Accessible.description.length > 0)
    var off = switches(page).filter(function(s) { return s.Accessible.name === "Menu" })[0]
    verify(!off.Accessible.checked)
    var unnamed = switches(page).filter(function(s) { return s.Accessible.name === "" })
    compare(unnamed.length, 0)
  }
  function test_every_button_is_named_by_its_text() {
    var pages = [settings(), setupPage(), pluginsPage()]
    pages[1].confirmRow = "layout-empty-widget"
    wait(300)
    var bad = []
    pages.forEach(function(page) {
      buttons(page).forEach(function(b) {
        if (b.Accessible.role !== Accessible.Button || b.Accessible.name !== b.text || b.text === "") bad.push(b.text)
      })
    })
    compare(bad.join("|"), "", "buttons a screen reader cannot name")
  }
  function test_a_fold_says_whether_it_is_open() {
    var page = settings()
    page.rows().filter(function(r) { return r.rid === "atRest" })[0].open = true
    var row = page.rows().filter(function(r) { return r.rid === "atRest" })[0]
    wait(300)
    verify(row.Accessible.expanded)
    var lines = walk(row).filter(function(i) { return i.leftAlign === true })
    verify(lines.length >= 4, "option lines: " + lines.length)
    compare(lines.filter(function(l) { return !l.Accessible.checkable }).length, 0)
  }

  // --- Reset asks twice (fix 5) ---------------------------------------------------

  function resetButton(page) { return page.rows().filter(function(r) { return r.rid === "reset" })[0].targets()[0] }
  function pressReset(page) { page.press("hover:reset"); page.press("key:space") }

  function test_reset_asks_before_it_deletes() {
    var page = settings()
    page.press("advanced")
    wait(300)
    compare(resetButton(page).text, "Reset")
    pressReset(page)
    compare(resetButton(page).text, "Sure?", "the button turns into the question")
    compare(bar.configEdits, 0, "nothing deleted by the first press")
    verify(bar.config.bar.notch !== undefined)
    pressReset(page)
    compare(bar.configEdits, 1, "the second press deletes")
    compare(bar.config.bar.notch, undefined)
    compare(resetButton(page).text, "Reset", "and the button is itself again")
  }
  function test_escape_takes_the_reset_question_back() {
    var page = settings()
    page.press("advanced")
    wait(300)
    var closed = 0
    page.closeRequested.connect(function() { closed++ })
    pressReset(page)
    compare(resetButton(page).text, "Sure?")
    page.press("key:escape")
    compare(resetButton(page).text, "Reset", "Escape answers no")
    compare(closed, 0, "and the panel stays open")
    pressReset(page)
    compare(bar.configEdits, 0, "a press after that asks again")
  }
  function test_the_reset_question_lapses_after_three_seconds() {
    var page = settings()
    page.press("advanced")
    wait(300)
    pressReset(page)
    wait(3300)
    compare(resetButton(page).text, "Reset")
    pressReset(page)
    compare(bar.configEdits, 0, "a press after the question lapsed asks again")
  }

  // --- Reduced motion (fix 7) -----------------------------------------------------

  // Opacity of the Text showing `words`, after `ms`.
  function textOpacity(page, words, ms) {
    var t = walk(page).filter(function(i) { return i.text === words && i.font !== undefined })[0]
    wait(ms)
    return t.opacity
  }
  readonly property var busyView: ({ id: "kalinewb.profiles", name: "Profiles", version: "1.4.0", state: "busy", words: "Installing", actions: [] })

  function test_reduced_motion_stills_the_busy_words_in_plugins() {
    bar.reducedMotion = true
    var page = pluginsPage()
    bar.pluginsViews = [busyView]
    compare(textOpacity(page, "Installing", 400), 1, "reduced")
    bar.reducedMotion = false
    verify(textOpacity(page, "Installing", 400) < 0.97, "breathing when motion is allowed")
  }
  function test_reduced_motion_stills_the_updating_title() {
    var title = function(page) { return walk(page).filter(function(i) { return i.text === "Updating Notch…" })[0] }
    bar.reducedMotion = true
    var page = make("file://@REPO@/NotchUpdate.qml", { bar: bar, notice: "updating", width: 360 })
    wait(400)
    compare(title(page).opacity, 1, "reduced")
    page.destroy()
    bar.reducedMotion = false
    page = make("file://@REPO@/NotchUpdate.qml", { bar: bar, notice: "updating", width: 360 })
    wait(400)
    verify(title(page).opacity < 0.97, "breathing when motion is allowed")
  }
  function test_reduced_motion_stills_the_plugins_notice_title() {
    var title = function(page) { return walk(page).filter(function(i) { return i.font !== undefined && i.text !== undefined && i.font.weight === Font.DemiBold && i.opacity !== undefined && i.text !== "" })[0] }
    bar.reducedMotion = true
    var page = make("file://@REPO@/plugins/NotchPluginsNotice.qml", { bar: bar, notice: "running", width: 360 })
    wait(400)
    compare(title(page).opacity, 1, "reduced")
    page.destroy()
    bar.reducedMotion = false
    page = make("file://@REPO@/plugins/NotchPluginsNotice.qml", { bar: bar, notice: "running", width: 360 })
    wait(400)
    verify(title(page).opacity < 0.97, "breathing when motion is allowed")
  }
  function test_reduced_motion_holds_the_spinner() {
    var spin = function() {
      var page = settings()
      var b = make("file://@REPO@/NotchPanelButton.qml", { page: page, iconText: "⟳", text: "Busy", iconSpinning: true })
      wait(250)
      var icon = walk(b).filter(function(i) { return i.text === "⟳" })[0]
      return icon.rotation
    }
    bar.reducedMotion = true
    compare(spin(), 0, "reduced")
    bar.reducedMotion = false
    verify(spin() !== 0, "turning when motion is allowed")
  }
  function test_reduced_motion_cuts_the_earlier_fixes_unfold() {
    var height = function(page) { return page.groups[1].children[1].height }
    bar.reducedMotion = true
    var page = setupPage()
    wait(100)
    var closed = height(page)
    page.groups[1].open = true
    wait(40)
    var cut = height(page)
    verify(cut > closed, "the fold opened")
    wait(400)
    compare(height(page), cut, "reduced: already at its full height after 40 ms")
    page.destroy()
    bar.reducedMotion = false
    page = setupPage()
    wait(100)
    page.groups[1].open = true
    wait(40)
    var mid = height(page)
    wait(400)
    verify(height(page) > mid, "animated when motion is allowed")
  }
  function test_reduced_motion_cuts_the_plugins_card() {
    var open = function() {
      var page = pluginsPage()
      bar.pluginsConfirm = { id: "kalinewb.profiles", action: "install", token: "t" }
      wait(60)
      var o = page.cardOpacity
      bar.pluginsConfirm = {}
      return o
    }
    bar.reducedMotion = true
    compare(open(), 1, "reduced: the card is there after 60 ms")
    bar.reducedMotion = false
    verify(open() < 1, "fading in when motion is allowed")
  }
  function test_reduced_motion_cuts_the_settings_controls() {
    bar.reducedMotion = true
    var page = settings()
    compare(page.settleMs + page.fadeMs, 0)
    bar.reducedMotion = false
    page = settings()
    verify(page.settleMs + page.fadeMs > 0)
  }

  // --- The Plugins card and tip (fix 9) ---------------------------------------------

  function cardText(page) { return walk(page).filter(function(i) { return i.text !== undefined && String(i.text).indexOf("\n") !== -1 || String(i.text).indexOf("unsandboxed") !== -1 || String(i.text).indexOf("folder is deleted") !== -1 })[0].text }

  function test_the_card_is_a_consent_line_and_one_state_line() {
    var page = pluginsPage()
    // An update with every surprise at once: the card still says one line of state.
    bar.pluginsPreview = { id: "kalinewb.face", ok: true, behind: 2, files: 3, insertions: 10, deletions: 2, commits: [],
                           renames: true, panelOpen: true, restartLikely: true, pluginBusy: true }
    bar.pluginsConfirmReady = true
    bar.pluginsConfirm = { id: "kalinewb.face", action: "update", token: "t" }
    wait(500)
    var lines = cardText(page).split("\n")
    compare(lines.length, 2, "update: " + lines.join(" / "))
    compare(lines[0], "Plugins run unsandboxed inside your shell.")
    compare(lines[1], "Renames Face ID to kalinewb.face and restarts the shell.", "the one surprise that matters most")
    bar.pluginsConfirm = {}
    wait(500)
    bar.pluginsPreview = {}
    bar.pluginsConfirm = { id: "kalinewb.profiles", action: "install", token: "t" }
    wait(500)
    compare(cardText(page).split("\n").length, 2, "install: " + cardText(page))
    bar.pluginsConfirm = {}
    wait(500)
    bar.pluginsConfirm = { id: "kalinewb.profiles", action: "remove", token: "t" }
    wait(500)
    compare(cardText(page).split("\n").length, 1, "remove: " + cardText(page))
  }
  function test_a_plugins_tip_is_its_own_summary_from_the_pointer_and_the_keyboard() {
    var page = pluginsPage()
    wait(100)
    page.press("hover:kalinewb.profiles")
    wait(500)
    var tip = page.tipReport()
    compare(tip.text, "Saves and switches whole Omarchy setups as profiles")
    compare(tip.source, "hover")
    page.press("unhover")
    page.selectedIndex = 0
    page.press("key:down")
    wait(400)
    tip = page.tipReport()
    compare(tip.source, "focus", "the keyboard reaches the tip")
    compare(tip.text, "Saves and switches whole Omarchy setups as profiles")
    page.press("key:up")
    wait(100)
    compare(page.tipReport().text, "Unlocks sudo with your face instead of a password", "the next row swaps it")
    verify(page.tipReport().text.length <= 60)
  }

  // --- The Setup page: zero rows, two problems, a check that failed -----------------------

  function cursorOf(page) { for (var i = 0; i < page.data.length; i++) if (page.data[i].stops !== undefined && page.data[i].at !== undefined) return page.data[i]; return null }
  function key(k, n) { for (var i = 0; i < (n || 1); i++) keyClick(k) }
  function said(page, start) { return walk(page).filter(function(i) { return i.text !== undefined && String(i.text).indexOf(start) === 0 && i.visible }).length }
  function allText(page) { return walk(page).filter(function(i) { return i.text !== undefined && i.font !== undefined && i.visible }).map(function(i) { return String(i.text) }).join("|") }

  function test_setup_a_healthy_machine_has_zero_rows_and_one_calm_line() {
    var page = setupPage()
    bar.setup.points = []
    bar.setup.snapshots = []
    wait(50)
    compare(page.rows().length, 0, "no rows")
    compare(said(page, "Everything is working."), 1)
    compare(said(page, "Checked just now."), 1)
    compare(names(buttons(page)), "‹ Settings|✕", "two buttons in the header and nothing else")
    compare(allText(page), "Setup|‹ Settings|✕|Everything is working.|Checked just now.", "the whole page")
  }
  function test_setup_two_problems_are_two_rows_with_one_button_each() {
    var page = setupPage()
    bar.setup.snapshots = []
    wait(50)
    compare(page.rows().length, 2)
    compare(said(page, "Everything is working."), 0)
    compare(page.rows().map(function(r) { return r.targets().map(function(b) { return b.text }).join("+") }).join("|"), "Move keys|Restart bar")
    var text = allText(page)
    ;["Worth knowing", "All good", "From a terminal", "Plugins", "Dismiss", "Snapshots"].forEach(function(w) { compare(text.indexOf(w), -1, "no '" + w + "'") })
  }
  function test_setup_a_failed_check_never_says_everything_is_working() {
    bar.setup.checkFailed = true
    var page = setupPage()
    wait(50)
    compare(said(page, "Couldn't check."), 1, "it says the check failed")
    compare(said(page, "Everything is working."), 0)
    compare(page.rows().length, 0, "and lists nothing it cannot vouch for")
    var retry = buttons(page).filter(function(b) { return b.text === "Try again" })
    compare(retry.length, 1)
    retry[0].clicked()
    compare(JSON.stringify(bar.setup.calls), JSON.stringify([["check"]]), "Try again checks again")
  }
  function test_setup_one_press_fixes_and_only_a_restart_asks_first() {
    var page = setupPage()
    wait(50)
    page.rows()[0].targets()[0].clicked()
    compare(JSON.stringify(bar.setup.calls), JSON.stringify([["fix", "menu-keys-bypass", ""]]), "no question for a fix that can be undone")
    compare(page.confirmRow, "")
    bar.setup.calls = []
    page.rows()[1].targets()[0].clicked()
    compare(page.confirmRow, "layout-empty-widget", "the restart asks")
    compare(JSON.stringify(bar.setup.calls), "[]", "nothing ran yet")
    compare(page.rows()[1].targets().map(function(b) { return b.text }).join("+"), "Cancel+Restart")
    verify(said(page, "This restarts the bar. The notch closes for a moment.") === 1)
    page.rows()[1].targets()[1].clicked()
    compare(JSON.stringify(bar.setup.calls), JSON.stringify([["fix", "layout-empty-widget", ""]]))
  }
  function test_setup_a_fixed_row_says_so_and_offers_undo_until_the_page_closes() {
    var page = setupPage()
    wait(50)
    page.rows()[0].targets()[0].clicked()
    bar.setup.job = ({ point: "menu-keys-bypass", action: "fix", phase: "done", snapshot: "snap-1" })
    bar.setup.points = [widget]   // healed, so detection no longer lists it
    wait(50)
    compare(page.rows().length, 2, "the fixed row stays")
    compare(said(page, "Fixed."), 1)
    var undo = page.rows()[1].targets()
    compare(undo.length, 1)
    compare(undo[0].text, "Undo")
    undo[0].clicked()
    compare(JSON.stringify(bar.setup.calls[bar.setup.calls.length - 1]), JSON.stringify(["restore", "snap-1", ""]))
  }
  function test_setup_a_failed_fix_says_nothing_was_changed() {
    var page = setupPage()
    bar.setup.job = ({ point: "menu-keys-bypass", action: "fix", phase: "rolled-back", message: "The fix didn't take." })
    wait(50)
    compare(said(page, "Couldn't fix this. Nothing was changed."), 1)
    compare(page.rows()[0].targets()[0].text, "Try again")
  }
  function test_setup_earlier_fixes_show_only_above_zero_and_have_one_undo() {
    var page = setupPage()
    bar.setup.snapshots = []
    wait(50)
    verify(!page.groups[1].visible, "no snapshots, no fold")
    page.destroy()
    page = setupPage()
    wait(50)
    verify(page.groups[1].visible)
    verify(said(page, "Earlier fixes (1)") === 1)
    page.groups[1].open = true
    wait(300)
    var undo = buttons(page).filter(function(b) { return b.text === "Undo" || b.text === "Restore" || b.text === "Delete" })
    compare(undo.map(function(b) { return b.text }).join("|"), "Undo", "one button, no Delete")
    undo[0].clicked()
    compare(JSON.stringify(bar.setup.calls[bar.setup.calls.length - 1]), JSON.stringify(["restore", "snap-1", ""]))
  }
  function test_setup_down_walks_the_points_and_the_fold() {
    var page = setupPage()
    wait(100)
    page.forceActiveFocus()
    var nav = cursorOf(page)
    var seen = []
    for (var i = 0; i < 4; i++) { key(Qt.Key_Down); seen.push(nav.at) }
    compare(seen.join(" "), "menu-keys-bypass layout-empty-widget earlier earlier", "points, then the fold, and it stops at the end")
    key(Qt.Key_Up, 2)
    compare(nav.at, "menu-keys-bypass")
  }
  function test_setup_enter_presses_the_rows_button_and_a_restart_confirms() {
    var page = setupPage()
    wait(100)
    page.forceActiveFocus()
    key(Qt.Key_Down)
    key(Qt.Key_Return)
    compare(JSON.stringify(bar.setup.calls), JSON.stringify([["fix", "menu-keys-bypass", ""]]), "Enter presses the button")
    bar.setup.calls = []
    key(Qt.Key_Down)
    key(Qt.Key_Return)
    compare(page.confirmRow, "layout-empty-widget", "a restart asks")
    compare(JSON.stringify(bar.setup.calls), "[]")
    key(Qt.Key_Escape)
    compare(page.confirmRow, "", "Escape says no")
    key(Qt.Key_Return)
    compare(page.confirmRow, "layout-empty-widget")
    key(Qt.Key_Right, 2)
    key(Qt.Key_Return)
    compare(JSON.stringify(bar.setup.calls), JSON.stringify([["fix", "layout-empty-widget", ""]]), "Right walks past Cancel to Restart, Enter restarts")
  }
  function test_setup_escape_closes_the_question_then_the_page() {
    var page = setupPage()
    wait(100)
    var closed = 0
    page.closeRequested.connect(function() { closed++ })
    page.forceActiveFocus()
    key(Qt.Key_Down, 2)
    key(Qt.Key_Return)
    compare(page.confirmRow, "layout-empty-widget")
    key(Qt.Key_Escape)
    compare(page.confirmRow, "", "the question first")
    compare(closed, 0)
    key(Qt.Key_Escape)
    compare(closed, 1, "then the page")
  }
  function test_setup_an_earlier_fix_is_reached_and_undone_from_the_keyboard() {
    var page = setupPage()
    wait(100)
    page.forceActiveFocus()
    var nav = cursorOf(page)
    key(Qt.Key_Down, 3)
    compare(nav.at, "earlier")
    key(Qt.Key_Space)
    wait(300)
    key(Qt.Key_Down)
    compare(nav.at, "snap-1", "Down from the open fold reaches its fix")
    key(Qt.Key_Return)
    compare(JSON.stringify(bar.setup.calls[bar.setup.calls.length - 1]), JSON.stringify(["restore", "snap-1", ""]))
  }
  function test_setup_buttons_hold_the_cursor_mark_and_tab_still_works() {
    var page = setupPage()
    wait(100)
    page.forceActiveFocus()
    var seen = tabWalk(page, 2)
    compare(seen.join("|"), "‹ Settings|✕", "Tab walks the header")
  }
  function test_setup_a_handoff_row_opens_the_plugins_own_step() {
    bar.setup.points = [face]
    var page = make("file://@REPO@/NotchSetup.qml", { bar: bar, maxHeight: 780, headerHeight: 32, width: 400 })
    wait(50)
    compare(page.rows().length, 1)
    compare(page.rows()[0].targets()[0].text, "Finish setup")
  }

  // --- Peeks, the chevron, the dimmed row (fix 10) ----------------------------------

  function rowOf(page, id) { return page.rows().filter(function(r) { return r.rid === id })[0] }
  function textsOf(row, wanted) { return walk(row).filter(function(i) { return i.text !== undefined && i.font !== undefined && wanted(String(i.text)) }) }

  function test_the_two_pop_ups_are_one_switch_that_sets_both() {
    var page = settings()
    var row = rowOf(page, "peeks")
    compare(row.kind, "switch")
    compare(row.label, "Track and charger pop-ups")
    page.press("set:peeks:false")
    compare(JSON.stringify(bar.writes[bar.writes.length - 1]), JSON.stringify({ peekOnTrackChange: false, batteryPeek: false }))
    page.press("set:peeks:true")
    compare(JSON.stringify(bar.writes[bar.writes.length - 1]), JSON.stringify({ peekOnTrackChange: true, batteryPeek: true }))
    bar.notchPeekOnTrackChange = false
    bar.notchBatteryPeek = false
    verify(!row.checked, "off when neither is on")
    bar.notchBatteryPeek = true
    verify(row.checked, "on when either is")
  }
  function test_one_chevron_closed_points_right_open_points_down() {
    var page = settings()
    var row = rowOf(page, "atRest")
    compare(textsOf(row, function(t) { return t.indexOf("▸") !== -1 }).length, 1, "closed: right")
    compare(textsOf(row, function(t) { return t.indexOf("▾") !== -1 || t.indexOf("▴") !== -1 }).length, 0)
    row.open = true
    wait(50)
    compare(textsOf(row, function(t) { return t.indexOf("▾") !== -1 }).length, 1, "open: down")
    compare(textsOf(row, function(t) { return t.indexOf("▴") !== -1 }).length, 0, "and never up")
    page.press("advanced")
    wait(300)
    var heading = walk(page).filter(function(i) { return i.text !== undefined && String(i.text).indexOf("Advanced") === 0 })[0]
    verify(heading.text.indexOf("▾") !== -1, "an open fold points down, as a Pick does")
  }
  function test_a_dimmed_row_dims_its_label_and_keeps_its_state_at_full_strength() {
    var page = settings()
    page.press("advanced")
    wait(300)
    var row = rowOf(page, "onHover")
    verify(row.dimmed, "hover opens the notch, so On hover is dimmed")
    compare(row.opacity, 1, "the row itself is not faded")
    var label = textsOf(row, function(t) { return t === "On hover" })[0]
    var state = textsOf(row, function(t) { return t.indexOf("Hover opens") === 0 })[0]
    compare(label.opacity, 0.45)
    compare(state.opacity, 1)
  }
}
